<Window x:Class="usage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:usage"
        Title="Grok 用量监控"
        Width="400"
        SizeToContent="Height"
        MinWidth="400" MaxWidth="400"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Closing="OnClosing"
        LocationChanged="OnLocationChanged"
        Activated="OnActivated"
        Deactivated="OnDeactivated">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
              Background="{StaticResource BgBrush}" Padding="12,8,10,8" MinHeight="50">
        <Grid MinHeight="34" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource GoldButton}" Content="刷新" Click="OnRefreshClick"
                  Padding="10,3" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                  Visibility="{Binding NormalActionsVisibility}"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="{Binding ErrorText}" Visibility="{Binding ErrorVisibility}"
                       Foreground="#FFB4B4" FontSize="11" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" MinHeight="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Visibility="{Binding NormalActionsVisibility}">
              <TextBlock Text="{Binding FooterLabel}" Foreground="{Binding FooterLabelBrush}"
                         FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding FooterClock}" Foreground="{StaticResource GoldBrush}"
                         FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Light"
                         Margin="6,0,0,0" VerticalAlignment="Center"
                         Visibility="{Binding FooterClockVisibility}"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource GhostButton}" Content="自启动" Click="OnStartupClick"
                    Foreground="{Binding StartupForeground}" Background="{Binding StartupBackground}"
                    Padding="8,3" FontSize="12" Margin="4,0,0,0" ToolTip="开机时静默启动"
                    Visibility="{Binding NormalActionsVisibility}"/>
            <Button Style="{StaticResource RedButton}" Content="退出" Click="OnExitClick"
                    Padding="8,3" FontSize="12" Margin="4,0,0,0" ToolTip="退出程序"
                    Visibility="{Binding NormalActionsVisibility}"/>
            <TextBlock Text="确认退出" Foreground="{StaticResource TextBrush}" FontSize="12"
                       VerticalAlignment="Center" Visibility="{Binding ConfirmExitVisibility}"/>
            <Button Style="{StaticResource GhostButton}" Content="取消" Click="OnCancelExitClick"
                    Padding="8,3" FontSize="12" Margin="6,0,0,0"
                    Visibility="{Binding ConfirmExitVisibility}"/>
            <Button Style="{StaticResource RedButton}" Content="确认" Click="OnConfirmExitClick"
                    Padding="8,3" FontSize="12" Margin="4,0,0,0" ToolTip="结束程序"
                    Visibility="{Binding ConfirmExitVisibility}"/>
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Margin="14,12,14,12">
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding AccountLine}" FontFamily="{StaticResource DisplayFont}"
                       FontSize="16" FontWeight="Light"/>
            <TextBlock Text="{Binding Email}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#242018" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
            <TextBlock Text="{Binding Tier}" FontFamily="{StaticResource DisplayFont}"
                       Foreground="{StaticResource GoldBrush}" FontSize="12" FontWeight="Medium"/>
          </Border>
        </Grid>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="112" Height="112">
            <local:RingGauge Value="{Binding UsedPercent}" Thickness="12"
                             TrackBrush="#2A2E36" FillBrush="{Binding RingBrush}"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource DisplayFont}"
                         FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
              <TextBlock Text="剩余" Foreground="{StaticResource MutedBrush}" FontSize="11"
                         HorizontalAlignment="Center" Margin="0,1,0,0"/>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock Text="{Binding UsedLine}" FontSize="14"/>
            <local:PercentBar Height="8" Margin="0,8,0,10" Value="{Binding UsedPercent}" Fill="{Binding RingBrush}"/>
            <TextBlock Text="{Binding ResetLine}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding PaceLine}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding RunoutLine}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="本周期" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
              <TextBlock Text="{Binding PeriodType}" FontFamily="{StaticResource DisplayFont}"
                         FontSize="18" FontWeight="Light" Margin="0,3,0,0"/>
              <TextBlock Text="{Binding PeriodRange}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="额外预付额度" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
              <TextBlock Text="{Binding PrepaidText}" FontFamily="{StaticResource DisplayFont}"
                         FontSize="18" FontWeight="Light" Margin="0,3,0,0"/>
              <TextBlock Text="{Binding PoolHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="产品拆分" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,0,0,8"/>
        <TextBlock Text="{Binding EmptyProducts}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,8">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding EmptyProducts}" Value="">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Products}" Margin="0,0,0,16">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,8" Height="22">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{Binding Color}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <local:PercentBar Grid.Column="1" Height="8" Margin="8,0" Value="{Binding Percent}"
                                  Fill="{Binding Color}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0:0.#}%}"
                           Foreground="{Binding Color}"
                           FontFamily="{StaticResource DisplayFont}" FontWeight="Light"
                           FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="近 7 天用量走势" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,0,0,8"/>
        <Border Style="{StaticResource Card}" Padding="12,10" Height="140">
          <local:Sparkline VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                           Points="{Binding History}" Stroke="{StaticResource GoldBrush}"/>
        </Border>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
